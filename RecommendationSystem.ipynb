        "def evaluate_precision_recall_at_k(engine, k=5, rating_threshold=4.0, sample_users=50):\n",
        "    ratings = engine.ratings_df\n",
        "    relevant_user_ratings = ratings[ratings['rating'] >= rating_threshold]\n",
        "    user_groups = relevant_user_ratings.groupby('userId')\n",
        "\n",
        "    precisions, recalls = [], []\n",
        "    processed = 0\n",
        "\n",
        "    for user_id, group in user_groups:\n",
        "        if len(group) < 5:\n",
        "            continue\n",
        "\n",
        "        liked_movie_ids = set(group['movieId'])\n",
        "        seed_movie_id = group.sample(1, random_state=42)['movieId'].values[0]\n",
        "        seed_movie_row = engine.movies_df[engine.movies_df['movieId'] == seed_movie_id]\n",
        "\n",
        "        if seed_movie_row.empty:\n",
        "            continue\n",
        "\n",
        "        seed_title = seed_movie_row['clean_title'].values[0]\n",
        "        recs = engine.recommend(seed_title, top_n=k)\n",
        "\n",
        "        if recs.empty:\n",
        "            continue\n",
        "\n",
        "        rec_movie_ids = set(engine.movies_df[engine.movies_df['title'].isin(recs['title'])]['movieId'])\n",
        "        hits = len(rec_movie_ids.intersection(liked_movie_ids))\n",
        "\n",
        "        precisions.append(hits / k)\n",
        "        recalls.append(hits / len(liked_movie_ids))\n",
        "\n",
        "        processed += 1\n",
        "        if processed >= sample_users:\n",
        "            break\n",
        "\n",
        "    if precisions:\n",
        "        print(f\"Evaluated Users: {processed}\")\n",
        "        print(f\"Mean Precision@{k}: {np.mean(precisions):.4f}\")\n",
        "        print(f\"Mean Recall@{k}: {np.mean(recalls):.4f}\")\n",
        "    else:\n",
        "        print(\"No valid evaluation samples found.\")\n",
        "\n",
        "# Run Evaluation\n",
        "evaluate_precision_recall_at_k(engine, k=5, sample_users=100)"
      ],
