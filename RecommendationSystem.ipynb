        "import os\n",
        "import re\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "from sklearn.feature_extraction.text import TfidfVectorizer\n",
        "from sklearn.metrics.pairwise import linear_kernel\n",
        "\n",
        "class ContentRecommender:\n",
        "    def __init__(self, movies_path: str, ratings_path: str):\n",
        "        self.movies_path = movies_path\n",
        "        self.ratings_path = ratings_path\n",
        "        self.movies_df = None\n",
        "        self.ratings_df = None\n",
        "        self.tfidf_matrix = None\n",
        "        self.cosine_sim = None\n",
        "        self.indices = None\n",
        "\n",
        "    def load_and_preprocess(self):\n",
        "        self.movies_df = pd.read_csv(self.movies_path)\n",
        "        self.ratings_df = pd.read_csv(self.ratings_path)\n",
        "\n",
        "        # Drop missing records\n",
        "        self.movies_df.dropna(subset=['title', 'genres'], inplace=True)\n",
        "        self.movies_df.drop_duplicates(subset=['movieId'], inplace=True)\n",
        "\n",
        "        # Clean string formats\n",
        "        self.movies_df['genres_processed'] = self.movies_df['genres'].str.replace('|', ' ', regex=False)\n",
        "        self.movies_df['genres_processed'] = self.movies_df['genres_processed'].str.replace('(no genres listed)', '', regex=False)\n",
        "        self.movies_df['clean_title'] = self.movies_df['title'].apply(lambda x: re.sub(r'\\s*\\(\\d{4}\\)', '', x).strip())\n",
        "\n",
        "    def fit(self):\n",
        "        tfidf = TfidfVectorizer(stop_words='english', token_pattern=r'(?u)\\b[\\w-]+\\b')\n",
        "        self.tfidf_matrix = tfidf.fit_transform(self.movies_df['genres_processed'])\n",
        "        self.cosine_sim = linear_kernel(self.tfidf_matrix, self.tfidf_matrix)\n",
        "\n",
        "        self.movies_df = self.movies_df.reset_index(drop=True)\n",
        "        # Ensure mapping drops any remaining index duplicates\n",
        "        self.indices = pd.Series(self.movies_df.index, index=self.movies_df['clean_title'].str.lower())\n",
        "        self.indices = self.indices[~self.indices.index.duplicated(keep='first')]\n",
        "\n",
        "    def recommend(self, title: str, top_n: int = 5):\n",
        "        key = title.strip().lower()\n",
        "        if key not in self.indices:\n",
        "            matches = self.movies_df[self.movies_df['clean_title'].str.lower().str.contains(key, regex=False)]\n",
        "            if matches.empty:\n",
        "                return pd.DataFrame()\n",
        "            idx = matches.index[0]\n",
        "        else:\n",
        "            idx = self.indices[key]\n",
        "            # Extra safety check: if multiple matches exist, pick the first scalar index\n",
        "            if isinstance(idx, pd.Series):\n",
        "                idx = idx.iloc[0]\n",
        "\n",
        "        # Ensure idx is an integer scalar\n",
        "        idx = int(idx)\n",
        "\n",
        "        # Flatten array slice to 1D vector\n",
        "        sim_vector = np.array(self.cosine_sim[idx]).flatten()\n",
        "\n",
        "        sim_scores = list(enumerate(sim_vector))\n",
        "        sim_scores = sorted(sim_scores, key=lambda x: x[1], reverse=True)\n",
        "        sim_scores = sim_scores[1:top_n + 1]\n",
        "\n",
        "        movie_indices = [i[0] for i in sim_scores]\n",
        "        results = self.movies_df.iloc[movie_indices][['title', 'genres']].copy()\n",
        "        results['similarity_score'] = [round(float(i[1]), 4) for i in sim_scores]\n",
        "        return results\n",
        "\n",
        "# Re-initialize and fit engine\n",
        "engine = ContentRecommender(\"ml-latest-small/movies.csv\", \"ml-latest-small/ratings.csv\")\n",
        "engine.load_and_preprocess()\n",
        "engine.fit()\n",
        "# Display recommendations for Toy Story\n",
        "display(engine.recommend(\"Toy Story\", top_n=5))"
      ],
